{
  "name": "medical-appointments-qa-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and Cucumber automation for the MedAppoint QA challenge",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:debug": "cucumber-js --fail-fast --format pretty",
    "test:debug:feature": "cucumber-js --fail-fast --format pretty",
    "test:debug:smoke": "cucumber-js --fail-fast --format pretty --tags @smoke",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
