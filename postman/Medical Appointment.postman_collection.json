          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const doctorId = pm.environment.get('doctorId');",
                  "",
                  "if (!doctorId) {",
                  "    throw new Error('doctorId is empty. Run GET Active Doctors first.');",
                  "}",
                  "",
                  "console.log('Calling availability for doctorId:', doctorId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Availability contains time_slots', function () {",
                  "    pm.expect(body).to.be.an('object');",
                  "    pm.expect(body).to.have.property('time_slots');",
                  "    pm.expect(body.time_slots).to.be.an('array').and.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('availableTimeSlots', JSON.stringify(body.time_slots));",
                  "console.log('Available time slots:', body.time_slots);"
                ]
              }
            }
          ],
