        {
          "name": "POST Create Appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const slots = JSON.parse(pm.environment.get('availableTimeSlots') || '[]');",
                  "",
                  "if (!slots.length) {",
                  "    throw new Error('No available time slots were found.');",
                  "}",
                  "",
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 1);",
                  "",
                  "pm.environment.set('appointmentDate', date.toISOString().split('T')[0]);",
                  "pm.environment.set('originalAppointmentDate', date.toISOString().split('T')[0]);",
                  "pm.environment.set('originalTimeSlot', slots[0]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const appointment = body.appointment || body;",
                  "",
                  "pm.test('Created appointment contains an ID', function () {",
                  "    pm.expect(appointment).to.be.an('object');",
                  "    pm.expect(appointment).to.have.property('id');",
                  "});",
                  "",
                  "pm.environment.set('appointmentId', String(appointment.id));",
                  "pm.environment.set('originalAppointmentDate', appointment.appointment_date || pm.environment.get('appointmentDate'));",
                  "pm.environment.set('originalTimeSlot', appointment.time_slot || pm.environment.get('originalTimeSlot'));",
                  "",
                  "console.log('appointmentId saved:', appointment.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": {{doctorId}},\n  \"appointment_date\": \"{{appointmentDate}}\",\n  \"time_slot\": \"{{originalTimeSlot}}\",\n  \"notes\": \"Created automatically for reschedule testing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
