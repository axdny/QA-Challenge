    {
      "name": "Reschedule Happy Path",
      "item": [
        {
          "name": "PUT Reschedule Appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const slots = JSON.parse(pm.environment.get('availableTimeSlots') || '[]');",
                  "const originalSlot = pm.environment.get('originalTimeSlot');",
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 3);",
                  "",
                  "const newSlot = slots.find(function (slot) {",
                  "    return slot !== originalSlot;",
                  "}) || originalSlot;",
                  "",
                  "pm.environment.set('newAppointmentDate', date.toISOString().split('T')[0]);",
                  "pm.environment.set('newTimeSlot', newSlot);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const appointment = body.appointment || body;",
                  "",
                  "pm.test('Response indicates success', function () {",
                  "    pm.expect(body).to.have.property('success');",
                  "    pm.expect(body.success).to.equal(true);",
                  "});",
                  "",
                  "pm.test('Appointment has the new schedule', function () {",
                  "    pm.expect(appointment.appointment_date).to.equal(pm.environment.get('newAppointmentDate'));",
                  "    pm.expect(appointment.time_slot).to.equal(pm.environment.get('newTimeSlot'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_date\": \"{{newAppointmentDate}}\",\n  \"time_slot\": \"{{newTimeSlot}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/reschedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{appointmentId}}",
                "reschedule"
              ]
            }
          },
          "response": []
        },
